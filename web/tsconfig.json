{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "cn": ["./src/lib/cn.ts"],
      "devignerui/hooks": ["./src/lib/hooks.ts"],
      "devignerui/motion": ["./src/lib/motion.ts"]
    }
  },
  "include": ["src"]
}
